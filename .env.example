# አውራ AI environment configuration
# Copy to .env and fill in real values. Never commit .env.

# ------------------------------------------------------------------
# Core LLM
# ------------------------------------------------------------------
# Required. Groq API key used by the reasoning agents.
GROQ_API_KEY=your_groq_api_key

# Optional. Google API key used for embeddings in the RAG pipeline.
GOOGLE_API_KEY=

# ------------------------------------------------------------------
# Authentication (required for the dashboard)
# ------------------------------------------------------------------
# Secret used to sign session cookies. Must be at least 32 characters and
# identical for the backend and the Next.js route guard.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AWRA_JWT_SECRET=

# Bootstrap accounts. An account is created only when its password is set.
ADMIN_EMAIL=admin@awra.ai
ADMIN_PASSWORD=
ANALYST_EMAIL=analyst@awra.ai
ANALYST_PASSWORD=

# Optional. Bearer key for service-to-service API access (not used by the browser).
AWRA_API_KEY=

# Set to true behind HTTPS so the session cookie is only sent over TLS.
COOKIE_SECURE=false

# ------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------
# Optional. Base URL of the backend API. In development Next.js proxies /api
# to http://127.0.0.1:8000, so this can stay unset.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ------------------------------------------------------------------
# Threat intelligence (optional; the demo gateway is used when empty)
# ------------------------------------------------------------------
# https://www.virustotal.com/
VT_API_KEY=
# https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=
# https://otx.alienvault.com/
OTX_API_KEY=
# GreyNoise and IPInfo free tiers do not require keys.
